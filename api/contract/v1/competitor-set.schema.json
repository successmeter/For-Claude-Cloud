{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub/contract/v1/competitor-set.schema.json",
  "title": "A competitor set with its current members (GET /hub/v1/orgs/{org}/competitor-sets/{set}). Members never carry matching data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "tools",
    "version",
    "activated_at",
    "composition_locked_until",
    "members"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "revenue",
          "web"
        ]
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "activated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "composition_locked_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "website_url",
        "location_text",
        "cuisine"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "website_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "location_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "cuisine": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
