{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub/contract/v1/org-list.schema.json",
  "title": "The signed-in user's organisations and roles (GET /hub/v1/me/orgs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orgs"
  ],
  "properties": {
    "orgs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "manager",
              "viewer"
            ]
          }
        }
      }
    }
  }
}
