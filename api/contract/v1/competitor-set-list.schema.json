{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub/contract/v1/competitor-set-list.schema.json",
  "title": "Competitor sets visible to the caller, without members (GET /hub/v1/orgs/{org}/competitor-sets).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sets"
  ],
  "properties": {
    "sets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "tools",
          "version",
          "activated_at",
          "composition_locked_until"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "tools": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "revenue",
                "web"
              ]
            }
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "activated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "composition_locked_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    }
  }
}
