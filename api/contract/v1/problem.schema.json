{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub/contract/v1/problem.schema.json",
  "title": "RFC 9457 problem details. Extension members are allowed (e.g. locked_until).",
  "type": "object",
  "required": [
    "type",
    "title",
    "status"
  ],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    }
  }
}
