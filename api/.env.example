APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# The Revenue app (Plan D): invitation links point here.
APP_FRONTEND_URL=http://localhost:5173
# Hosts whose browser requests get the cookie session: the Revenue app's host (it proxies /api and
# /sanctum here). The default covers localhost, including the Vite dev server on :5173.
# SANCTUM_STATEFUL_DOMAINS=app.successmeter.tech
# Public sign-up (POST /api/register). Off: accounts are by invitation (hub:invite-business).
HUB_OPEN_REGISTRATION=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql_app
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=revenue_benchmarking
DB_USERNAME=sail
DB_PASSWORD=password
# Restricted, non-superuser role created by the Task 3 RLS migration. The pgsql_app
# connection (the app's default) authenticates as this role so row-level security on
# venues/memberships is actually enforced (table owners and superusers bypass RLS).
DB_APP_USERNAME=app_user
DB_APP_PASSWORD=app_user_password

# Host port forwarding only (container-network DB_HOST/REDIS_HOST are unaffected);
# 5432/6379 are already bound by another project's containers on this machine.
FORWARD_DB_PORT=54322
FORWARD_REDIS_PORT=61379

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

KMS_MASTER_KEY=

# Upload malware scanning (Plan C): 'clamav' needs clamd at CLAMD_ADDRESS; 'none' is for local only.
INGEST_SCANNER=clamav
CLAMD_ADDRESS=unix:///var/run/clamav/clamd.ctl

# Hub OIDC provider (Plan B). Locally, `php artisan passport:keys` writes storage/oauth-*.key
# (gitignored). In production supply the key pair from the secrets manager instead.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
HUB_ISSUER=
OPENID_FORCE_HTTPS=true

# Production on AWS (set by infra/, see docs/hosting-aws.md; leave unset locally):
# TRUSTED_PROXIES=*            trust the load balancer's X-Forwarded-* headers
# KMS_DRIVER=aws  KMS_KEY_ID=  per-org data keys from AWS KMS (local driver otherwise)
# SNAPSHOTS_DRIVER=s3  SNAPSHOTS_BUCKET=
# DB_SSLMODE=require

# Square POS (Plan E). Leave the id empty to keep Square off. Sandbox credentials for development.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENVIRONMENT=sandbox

# Deployed hosts (see docs/hosting-laravel-cloud.md). The app runs as app_user (pgsql_app); HUB_DB_CONNECTION
# wins over a host's own DB_CONNECTION. Outside AWS, KMS uses its own keys; INGEST_SCANNER=off where there is no ClamAV.
# HUB_DB_CONNECTION=pgsql_app
# KMS_AWS_ACCESS_KEY_ID=
# KMS_AWS_SECRET_ACCESS_KEY=
# SNAPSHOTS_SSE=none
